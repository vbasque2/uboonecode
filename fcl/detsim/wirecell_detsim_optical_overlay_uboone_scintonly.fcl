# Reco2 optical detsim for a Cherenkov-ON reco1 file, SCINTILLATION ONLY.
#
# Identical to wirecell_detsim_optical_overlay_uboone.fcl except that the
# visible-light quantum efficiency is set to zero, so the Cherenkov photons
# stored in the SimPhotons are discarded at the waveform stage and the result
# is what the scintillation-only chain gives. The 128 nm entries are
# unchanged (0.0093 / ScintPreScale = 1, exactly the stock behaviour).
#
# REQUIRES the Cherenkov build (patched ubsim/ubevt). Running the STOCK
# release detsim on a Cherenkov-on file is wrong: the stock code applies the
# flat QE (0.0093 / 0.0093 = 1) to every photon, so Cherenkov photons would be
# detected with 100 per cent efficiency instead of being dropped.
#
# Columns follow WavelengthSpectrum [0, 300, 301, 1000] nm.

#include "wirecell_detsim_optical_overlay_uboone.fcl"

services.UBOpticalChConfig.QESpec: [ # QE values per channel and then per each one of the wavelength values in WavelengthSpectrum
    [0.0093, 0.0093, 0.00, 0.00], [0.0093, 0.0093, 0.00, 0.00], [0.0093, 0.0093, 0.00, 0.00], 
    [0.0093, 0.0093, 0.00, 0.00], [0.0093, 0.0093, 0.00, 0.00], [0.0093, 0.0093, 0.00, 0.00],
